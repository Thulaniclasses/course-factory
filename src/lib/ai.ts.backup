import OpenAI from "openai";

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

export interface GeneratedCourse {
  title: string;
  description: string;
  modules: {
    id: string;
    title: string;
    content: string[];
    scenario: {
      prompt: string;
      options: {
        id: string;
        text: string;
        isCorrect: boolean;
        feedback: string;
      }[];
    };
    quiz: {
      question: string;
      options: string[];
      correctIndex: number;
    }[];
  }[];
}

const SYSTEM_PROMPT = `You are a senior instructional designer specializing in eLearning for financial intelligence and compliance training.

Your job: take raw source material and transform it into a structured, interactive eLearning course.

RULES:
1. Create 3 to 5 modules. Each module should take 5-10 minutes to complete.
2. Each module must have 3-5 content cards (short, punchy paragraphs — not walls of text).
3. Each module must have ONE branching scenario with exactly 2 options (one correct, one incorrect). Include feedback for each choice.
4. Each module must have 2-3 quiz questions with 4 options each.
5. Language must be professional, clear, and accessible to international FIU (Financial Intelligence Unit) analysts.
6. Always respond with valid JSON only — no markdown, no explanations, no code fences.

OUTPUT SCHEMA (must match exactly):
{
  "title": "string",
  "description": "string (1-2 sentences)",
  "modules": [
    {
      "id": "m1",
      "title": "string",
      "content": ["card 1 text", "card 2 text", "card 3 text"],
      "scenario": {
        "prompt": "string (the scenario setup)",
        "options": [
          { "id": "a", "text": "string", "isCorrect": false, "feedback": "string" },
          { "id": "b", "text": "string", "isCorrect": true, "feedback": "string" }
        ]
      },
      "quiz": [
        { "question": "string", "options": ["a", "b", "c", "d"], "correctIndex": 0 }
      ]
    }
  ]
}`;

export async function generateCourse(sourceText: string): Promise<GeneratedCourse> {
  const response = await openai.chat.completions.create({
    model: "gpt-4o-mini",
    response_format: { type: "json_object" },
    temperature: 0.7,
    messages: [
      { role: "system", content: SYSTEM_PROMPT },
      {
        role: "user",
        content: `Transform this source material into an eLearning course:\n\n${sourceText}`,
      },
    ],
  });

  const raw = response.choices[0]?.message?.content;
  if (!raw) throw new Error("Empty response from AI");

  const parsed = JSON.parse(raw) as GeneratedCourse;
  return parsed;
}
