"use client";

import { Eye, Layers, Download, Copy, Check, BookOpen } from "lucide-react";
import { useState } from "react";
import type { GeneratedCourse } from "@/lib/ai";

interface PreviewProps {
  course: GeneratedCourse | null;
}

export function Preview({ course }: PreviewProps) {
  const [copied, setCopied] = useState(false);

  const handleCopy = async () => {
    if (!course) return;
    await navigator.clipboard.writeText(JSON.stringify(course, null, 2));
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const handleDownload = () => {
    if (!course) return;
    const blob = new Blob([JSON.stringify(course, null, 2)], {
      type: "application/json",
    });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `${course.title.replace(/\s+/g, "-").toLowerCase()}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const totalCards = course?.modules.reduce(
    (sum, m) => sum + m.content.length,
    0
  );
  const totalQuiz = course?.modules.reduce((sum, m) => sum + m.quiz.length, 0);

  return (
    <div className="w-[460px] h-screen bg-neutral-950 border-l border-neutral-800 flex flex-col shrink-0">
      <header className="border-b border-neutral-800 px-6 py-5 flex items-center justify-between">
        <div className="flex items-center gap-2">
          <Eye className="w-4 h-4 text-neutral-500" />
          <h3 className="text-sm font-semibold text-white">Live Preview</h3>
        </div>
        {course && (
          <div className="flex items-center gap-2">
            <button
              onClick={handleCopy}
              className="text-xs text-neutral-400 hover:text-white flex items-center gap-1 px-2 py-1 rounded-md hover:bg-neutral-900 transition-colors"
            >
              {copied ? (
                <>
                  <Check className="w-3.5 h-3.5 text-emerald-500" />
                  Copied
                </>
              ) : (
                <>
                  <Copy className="w-3.5 h-3.5" />
                  Copy
                </>
              )}
            </button>
            <button
              onClick={handleDownload}
              className="text-xs text-neutral-400 hover:text-white flex items-center gap-1 px-2 py-1 rounded-md hover:bg-neutral-900 transition-colors"
            >
              <Download className="w-3.5 h-3.5" />
              JSON
            </button>
          </div>
        )}
      </header>

      {!course ? (
        <div className="flex-1 flex items-center justify-center p-6">
          <div className="text-center">
            <Layers className="w-12 h-12 text-neutral-800 mx-auto mb-4" />
            <p className="text-sm text-neutral-500">
              Your generated course will appear here.
            </p>
            <p className="text-xs text-neutral-700 mt-2">
              Modules, branching scenarios, and quizzes will render live.
            </p>
          </div>
        </div>
      ) : (
        <div className="flex-1 overflow-y-auto">
          <div className="p-6 border-b border-neutral-900">
            <p className="text-[10px] uppercase tracking-wider text-emerald-500 font-medium mb-2">
              Course Generated
            </p>
            <h2 className="text-lg font-semibold text-white leading-tight">
              {course.title}
            </h2>
            <p className="text-sm text-neutral-400 mt-2 leading-relaxed">
              {course.description}
            </p>
            <div className="flex items-center gap-3 mt-3 text-[11px] text-neutral-500">
              <span className="flex items-center gap-1">
                <BookOpen className="w-3 h-3" />
                {course.modules.length} modules
              </span>
              <span>·</span>
              <span>{totalCards} cards</span>
              <span>·</span>
              <span>{totalQuiz} quiz questions</span>
            </div>
          </div>

          <div className="p-6 space-y-6">
            {course.modules.map((module, idx) => (
              <div key={module.id} className="space-y-3">
                <div className="flex items-center gap-2">
                  <span className="text-[10px] uppercase tracking-wider text-neutral-500">
                    Module {idx + 1}
                  </span>
                </div>
                <h3 className="text-sm font-semibold text-white">
                  {module.title}
                </h3>

                <div className="space-y-2">
                  {module.content.map((card, i) => (
                    <div
                      key={i}
                      className="bg-neutral-900/50 border border-neutral-800 rounded-lg p-3 text-xs text-neutral-300 leading-relaxed"
                    >
                      {card}
                    </div>
                  ))}
                </div>

                <div className="pt-2">
                  <p className="text-[10px] uppercase tracking-wider text-amber-500 font-medium mb-2">
                    Branching Scenario
                  </p>
                  <p className="text-xs text-neutral-300 mb-3 leading-relaxed">
                    {module.scenario.prompt}
                  </p>
                  <div className="space-y-2">
                    {module.scenario.options.map((opt) => (
                      <div
                        key={opt.id}
                        className={
                          opt.isCorrect
                            ? "border border-emerald-900/60 bg-emerald-950/30 rounded-lg p-3"
                            : "border border-neutral-800 rounded-lg p-3"
                        }
                      >
                        <div className="flex items-start gap-2">
                          <span className="text-[10px] font-mono text-neutral-500 mt-0.5 uppercase">
                            {opt.id})
                          </span>
                          <div className="flex-1">
                            <p className="text-xs text-neutral-300">
                              {opt.text}
                            </p>
                            {opt.isCorrect && (
                              <p className="text-[11px] text-emerald-400 mt-1">
                                ✓ {opt.feedback}
                              </p>
                            )}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <div className="pt-2">
                  <p className="text-[10px] uppercase tracking-wider text-blue-400 font-medium mb-2">
                    Quiz ({module.quiz.length} questions)
                  </p>
                  <div className="space-y-3">
                    {module.quiz.map((q, qi) => (
                      <div key={qi}>
                        <p className="text-xs text-neutral-300 mb-2">
                          {qi + 1}. {q.question}
                        </p>
                        <div className="space-y-1">
                          {q.options.map((opt, oi) => (
                            <div
                              key={oi}
                              className={
                                oi === q.correctIndex
                                  ? "text-[11px] text-emerald-400 flex items-center gap-1.5"
                                  : "text-[11px] text-neutral-500 flex items-center gap-1.5"
                              }
                            >
                              <span className="font-mono">
                                {oi === q.correctIndex ? "✓" : "○"}
                              </span>
                              {opt}
                            </div>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
